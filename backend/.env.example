APP_NAME=Full-Time VA
ENVIRONMENT=production
PUBLIC_BASE_URL=https://va.example.com
DATABASE_URL=sqlite+aiosqlite:///./data/full_time_va.db
PAIRING_SECRET=replace-with-a-long-one-time-pairing-secret
TOKEN_ENCRYPTION_KEY=generate-with-python-command-in-README

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://va.example.com/api/google/callback
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_PUBSUB_TOPIC=

AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=90
# Free-tier request/token budgets and fallback providers are configured from the Android app.

ENABLE_BANKING_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enable_banking_private_key.pem
ENABLE_BANKING_REDIRECT_URI=https://va.example.com/api/banking/callback

FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
DEFAULT_TIMEZONE=Europe/Brussels
GMAIL_SYNC_MINUTES=5
BANK_SYNC_MINUTES=30
AUTOMATION_ENABLED=true

# GitHub personal automation (fine-grained token recommended)
GITHUB_TOKEN=
GITHUB_API_VERSION=2022-11-28

# Cloudflare account administration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Discord notifications and routine operational messages
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=

GOOGLE_DRIVE_ARCHIVE_FOLDER=Full-Time VA
EXTERNAL_SYNC_MINUTES=30
